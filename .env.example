# Copy to .env if you want to change anything. Defaults work with a stock local Ollama.
# The agent runs on a LOCAL model - nothing is sent to a cloud service.

# Where Ollama is listening
OLLAMA_HOST=http://localhost:11434

# The model. It must support TOOL CALLING. Good starting points:
#   qwen2.5:7b (default) | llama3.1:8b | mistral-nemo | qwen2.5:14b (better, needs more RAM)
OLLAMA_MODEL=qwen2.5:7b

# Context window in tokens. Ollama's own default (~4k) would silently cut off the agent's prompt.
# Lower it if you run out of memory; below ~8192 the agent will struggle on longer tasks.
OLLAMA_NUM_CTX=16384

# Seconds to wait for one model reply (local models can be slow on CPU)
OLLAMA_TIMEOUT=300

# How long Ollama keeps the model loaded after a call (avoids reloading it between steps)
OLLAMA_KEEP_ALIVE=30m

PORT=5000
# Seconds to wait for you to answer a question/approval before the run stops safely
AGENT_USER_TIMEOUT=300
